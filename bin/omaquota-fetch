#!/usr/bin/env python3
"""omaquota-fetch - collect a CLIProxyAPI snapshot for the Omaquota bar widget.

Usage:  omaquota-fetch '<settings-json>' [--force] [--print]

Talks to the proxy's management API: `auth-files` for the subscription list,
`usage-queue` for per-request token records, and for every enabled
subscription the provider's own usage endpoint through the proxy's
`api-call` passthrough (which injects the account's OAuth token). Writes one
JSON snapshot to ~/.local/state/omarchy/omaquota/snapshot.json, atomically.

The usage queue is pop-on-read, so this script is its consumer: records are
folded into hourly buckets in usage.json (kept for 7 days) and priced with
the models.dev catalogue (cached for a day in models-dev.json). Run only one
consumer per proxy.

Quota lookups are rate-limited upstream (Anthropic answers 429 with a
Retry-After when polled too eagerly), so they are cached for
`quotaIntervalSec` and any 429 parks the account until Retry-After elapses,
keeping the last good windows marked `stale`. Stdlib only.
"""

import json
import os
import sys
import time
import tempfile
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

STATE_DIR = os.path.expanduser("~/.local/state/omarchy/omaquota")
SNAPSHOT = os.path.join(STATE_DIR, "snapshot.json")
TIMEOUT = 12

CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_HEADERS = {
    "Authorization": "Bearer $TOKEN$",
    "Content-Type": "application/json",
    "anthropic-beta": "oauth-2025-04-20",
}
CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
CODEX_HEADERS = {
    "Authorization": "Bearer $TOKEN$",
    "Content-Type": "application/json",
    "User-Agent": "codex-tui/0.149.1 (Mac OS 26.5.2; arm64) iTerm.app/3.6.11 (codex-tui; 0.149.1)",
}
XAI_WEEKLY_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
XAI_MONTHLY_URL = "https://cli-chat-proxy.grok.com/v1/billing"
XAI_HEADERS = {
    "Authorization": "Bearer $TOKEN$",
    "x-xai-token-auth": "xai-grok-cli",
    "x-grok-client-version": "0.2.91",
    "accept": "*/*",
}


def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def parse_iso(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


class Client:
    def __init__(self, base_url, key):
        self.base = base_url.rstrip("/")
        self.key = key

    def _req(self, path, method="GET", body=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.base + path, data=data, method=method)
        req.add_header("Authorization", "Bearer " + self.key)
        if data is not None:
            req.add_header("Content-Type", "application/json")
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            raw = r.read()
        return json.loads(raw) if raw.strip() else None

    def get(self, path):
        return self._req(path)

    def api_call(self, auth_index, url, headers):
        """Provider request through the proxy; `$TOKEN$` becomes the account token."""
        r = self._req("/v0/management/api-call", "POST", {
            "auth_index": auth_index, "method": "GET", "url": url, "header": headers,
        })
        status = int(r.get("status_code") or 0)
        body = r.get("body")
        if isinstance(body, str):
            try:
                body = json.loads(body)
            except ValueError:
                pass
        hdrs = r.get("header") or {}
        retry = None
        for k, v in hdrs.items():
            if k.lower() == "retry-after" and v:
                try:
                    retry = int(v[0] if isinstance(v, list) else v)
                except ValueError:
                    retry = None
        return status, body, retry


# ----------------------------------------------------------------- usage

USAGE_FILE = os.path.join(STATE_DIR, "usage.json")
PRICES_FILE = os.path.join(STATE_DIR, "models-dev.json")
MODELS_DEV_URL = "https://models.dev/api.json"
RETAIN_S = 7 * 86400
RANGES = {"24h": 86400, "7d": 7 * 86400}
# CLIProxyAPI provider ids -> models.dev provider ids tried first.
PROVIDER_MAP = {
    "codex": ["openai"], "openai": ["openai"], "claude": ["anthropic"],
    "anthropic": ["anthropic"], "xai": ["xai"], "gemini": ["google"],
    "gemini-cli": ["google"], "antigravity": ["google"], "kimi": ["moonshotai"],
    "qwen": ["alibaba"], "iflow": ["iflow"], "vertex": ["google-vertex"],
}

EMPTY_BUCKET = {"requests": 0, "failed": 0, "uncached": 0, "cache_read": 0, "cache_write": 0,
                "output": 0, "latency_ms": 0, "latency_n": 0, "ttft_ms": 0, "ttft_n": 0}


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(STATE_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".tmp.", suffix=".json")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def record_tokens(rec):
    """Return (uncached_in, cache_read, cache_write, output)."""
    tb = rec.get("token_breakdown") or {}
    if isinstance(tb.get("input"), dict):
        i, o = tb["input"], tb.get("output") or {}
        return (int(i.get("uncached_tokens") or 0), int(i.get("cache_read_tokens") or 0),
                int(i.get("cache_write_tokens") or 0), int(o.get("total_tokens") or 0))
    t = rec.get("tokens") or {}
    inp = int(t.get("input_tokens") or 0)
    cached = int(t.get("cache_read_tokens") or t.get("cached_tokens") or 0)
    # OpenAI counts cached tokens inside input_tokens, Anthropic does not.
    uncached = inp - cached if inp >= cached else inp
    return max(0, uncached), cached, int(t.get("cache_creation_tokens") or 0), int(t.get("output_tokens") or 0)


def drain_queue(client, usage):
    """Pop every pending usage record and fold it into hourly buckets."""
    buckets = usage.setdefault("buckets", {})
    for _ in range(40):
        batch = client.get("/v0/management/usage-queue?count=500") or []
        if not isinstance(batch, list) or not batch:
            break
        # Keep a few raw records around: token accounting is easy to get subtly wrong.
        recent = usage.setdefault("recent_records", [])
        recent.extend(batch[-20:]); del recent[:-20]
        for rec in batch:
            ts = parse_iso(rec.get("timestamp")) or time.time()
            hour = int(ts // 3600) * 3600
            key = "%d|%s|%s|%s" % (hour, rec.get("provider") or "?", rec.get("model") or "?",
                                    rec.get("source") or "?")
            b = buckets.get(key)
            if b is None:
                b = dict(EMPTY_BUCKET); buckets[key] = b
            unc, cr, cw, out = record_tokens(rec)
            b["requests"] += 1
            b["failed"] += 1 if rec.get("failed") else 0
            b["uncached"] += unc; b["cache_read"] += cr; b["cache_write"] += cw; b["output"] += out
            if rec.get("latency_ms") is not None:
                b["latency_ms"] += int(rec["latency_ms"]); b["latency_n"] += 1
            if rec.get("ttft_ms") is not None:
                b["ttft_ms"] += int(rec["ttft_ms"]); b["ttft_n"] += 1
        if len(batch) < 500:
            break
    usage.setdefault("first_seen", time.time())
    cutoff = time.time() - RETAIN_S
    for key in [k for k in buckets if int(k.split("|", 1)[0]) < cutoff]:
        del buckets[key]


def backfill_from_tracker(client, usage):
    """One-time seed of history from the cap-token-usage-tracker plugin when the
    proxy happens to have it; hours before this consumer's first drain only, so
    nothing is counted twice. Skipped silently when the plugin is absent."""
    if usage.get("backfilled"):
        return 0
    usage["backfilled"] = True
    try:
        d = client.get("/v0/resource/plugins/cap-token-usage-tracker/stats?range=7d") or {}
    except Exception:
        return 0
    series = d.get("model_series") or []
    provider_of = {}
    for g in d.get("groups") or []:
        if g.get("model") and g.get("provider"):
            provider_of.setdefault(g["model"], g["provider"])
    first = usage.get("first_seen") or time.time()
    first_hour = int(first // 3600) * 3600
    buckets = usage.setdefault("buckets", {})
    added = 0
    for row in series:
        ts = parse_iso(row.get("hour"))
        if ts is None:
            continue
        hour = int(ts // 3600) * 3600
        if hour >= first_hour or int(row.get("requests") or 0) == 0:
            continue
        model = row.get("model") or "?"
        key = "%d|%s|%s|%s" % (hour, provider_of.get(model, "?"), model, "(backfill)")
        b = buckets.get(key)
        if b is None:
            b = dict(EMPTY_BUCKET); buckets[key] = b
        inp = int(row.get("input_tokens") or 0)
        cr = int(row.get("cache_read_tokens") or row.get("cached_tokens") or 0)
        b["requests"] += int(row.get("requests") or 0)
        b["failed"] += int(row.get("failed_requests") or 0)
        b["uncached"] += max(0, inp - cr) if inp >= cr else inp
        b["cache_read"] += cr
        b["cache_write"] += int(row.get("cache_creation_tokens") or 0)
        b["output"] += int(row.get("output_tokens") or 0)
        b["latency_ms"] += int(row.get("total_latency_ns") or 0) // 1000000
        b["latency_n"] += int(row.get("latency_samples") or 0)
        b["ttft_ms"] += int(row.get("total_ttft_ns") or 0) // 1000000
        b["ttft_n"] += int(row.get("ttft_samples") or 0)
        added += 1
    if added:
        usage["backfill_until"] = time.time()
        usage["first_seen"] = min(first, min(int(k.split("|", 1)[0]) for k in buckets))
    return added


def load_prices():
    """models.dev cost table keyed "provider|model", refreshed daily."""
    cache = load_json(PRICES_FILE, {})
    if not cache or time.time() - (cache.get("fetched_at") or 0) > 86400:
        try:
            req = urllib.request.Request(MODELS_DEV_URL, headers={"User-Agent": "omaquota"})
            with urllib.request.urlopen(req, timeout=20) as r:
                catalog = json.loads(r.read())
            table = {}
            for prov, pdata in catalog.items():
                for mid, m in (pdata.get("models") or {}).items():
                    c = m.get("cost") or {}
                    if c.get("input") is None and c.get("output") is None:
                        continue
                    table[prov + "|" + mid] = {
                        "in": float(c.get("input") or 0), "out": float(c.get("output") or 0),
                        "cr": float(c.get("cache_read") if c.get("cache_read") is not None else c.get("input") or 0),
                        "cw": float(c.get("cache_write") if c.get("cache_write") is not None else c.get("input") or 0),
                    }
            cache = {"fetched_at": time.time(), "table": table}
            save_json(PRICES_FILE, cache)
        except Exception:
            pass  # keep whatever we had
    return cache.get("table") or {}


def price_for(table, provider, model):
    for prov in PROVIDER_MAP.get(provider, []) + [provider]:
        p = table.get(prov + "|" + model)
        if p:
            return p
    # Any provider that lists this exact model id (aggregators re-list vendors' models).
    for key, p in table.items():
        if key.endswith("|" + model):
            return p
    return None


def cost_of(b, p):
    return (b["uncached"] * p["in"] + b["cache_read"] * p["cr"]
            + b["cache_write"] * p["cw"] + b["output"] * p["out"]) / 1e6


def stats_for(usage, table, rng):
    span = RANGES[rng]
    now = time.time()
    since = now - span
    tot = dict(EMPTY_BUCKET)
    tot.update({"cost": 0.0, "cost_in": 0.0, "cost_out": 0.0, "cost_cache": 0.0, "unpriced": 0})
    models = {}
    for key, b in usage.get("buckets", {}).items():
        hour, provider, model, _source = key.split("|", 3)
        if int(hour) + 3600 <= since:
            continue
        m = models.setdefault(model, {"model": model, "provider": provider, "requests": 0,
                                      "failed": 0, "total_tokens": 0, "output_tokens": 0,
                                      "cost": 0.0, "priced": True})
        for k in EMPTY_BUCKET:
            tot[k] += b[k]
        m["requests"] += b["requests"]; m["failed"] += b["failed"]
        m["total_tokens"] += b["uncached"] + b["cache_read"] + b["cache_write"] + b["output"]
        m["output_tokens"] += b["output"]
        p = price_for(table, provider, model)
        if p:
            c = cost_of(b, p)
            m["cost"] += c; tot["cost"] += c
            tot["cost_in"] += b["uncached"] * p["in"] / 1e6
            tot["cost_out"] += b["output"] * p["out"] / 1e6
            tot["cost_cache"] += (b["cache_read"] * p["cr"] + b["cache_write"] * p["cw"]) / 1e6
        else:
            m["priced"] = False; tot["unpriced"] += b["requests"]
    inp = tot["uncached"] + tot["cache_read"]
    first = usage.get("first_seen") or now
    rows = sorted(models.values(), key=lambda x: -x["requests"])[:6]
    return {
        "range": rng,
        "requests": tot["requests"],
        "failed": tot["failed"],
        "input_tokens": inp,                     # uncached + cache reads (everything the model read)
        "uncached_tokens": tot["uncached"],
        "cache_write_tokens": tot["cache_write"],
        "output_tokens": tot["output"],
        "cached_tokens": tot["cache_read"],
        "total_tokens": inp + tot["cache_write"] + tot["output"],
        "cache_hit": (tot["cache_read"] / inp) if inp else 0.0,
        "avg_latency_ms": (tot["latency_ms"] / tot["latency_n"]) if tot["latency_n"] else None,
        "avg_ttft_ms": (tot["ttft_ms"] / tot["ttft_n"]) if tot["ttft_n"] else None,
        "cost_usd": round(tot["cost"], 2),
        "cost_in_usd": round(tot["cost_in"], 2),
        "cost_out_usd": round(tot["cost_out"], 2),
        "cost_cache_usd": round(tot["cost_cache"], 2),
        "unpriced_requests": tot["unpriced"],
        "priced": bool(table),
        "models": [dict(r, cost=round(r["cost"], 2)) for r in rows],
        # Coverage starts when this consumer first drained the queue.
        "covered_since": first if now - first < span else None,
        "note": ("before %s imported from the usage-tracker plugin (approx)" % time.strftime("%d %b %H:%M", time.localtime(usage["backfill_until"])))
                if usage.get("backfill_until") else None,
    }


# ----------------------------------------------------------------- quota

def window(wid, label, used, resets_at_ts):
    used = None if used is None else max(0.0, min(100.0, float(used)))
    return {
        "id": wid,
        "label": label,
        "used_pct": used,
        "remaining_pct": None if used is None else round(100.0 - used, 1),
        "resets_at": resets_at_ts,
    }


def claude_quota(body):
    wins = []
    named = [("five_hour", "5h"), ("seven_day", "7d"), ("seven_day_oauth_apps", "7d apps"),
             ("seven_day_opus", "7d opus"), ("seven_day_sonnet", "7d sonnet"), ("seven_day_cowork", "7d cowork")]
    for key, label in named:
        w = body.get(key)
        if isinstance(w, dict) and w.get("utilization") is not None:
            wins.append(window(key, label, w.get("utilization"), parse_iso(w.get("resets_at"))))
    # Model-scoped weekly limits (e.g. the Fable weekly cap) live in `limits[]`.
    for lim in body.get("limits") or []:
        if not isinstance(lim, dict) or lim.get("kind") != "weekly_scoped":
            continue
        model = ((lim.get("scope") or {}).get("model") or {}).get("display_name") or "scoped"
        if lim.get("percent") is None:
            continue
        wins.append(window("weekly_scoped:" + model.lower(), "7d " + model.lower(),
                           lim.get("percent"), parse_iso(lim.get("resets_at"))))
    return {"windows": wins, "plan": None}


def codex_label(seconds):
    if not seconds:
        return "?"
    if seconds <= 18000:
        return "5h"
    if seconds <= 604800:
        return "7d"
    return "30d"


def codex_quota(body):
    wins = []
    def add(prefix, rl):
        if not isinstance(rl, dict):
            return
        for slot in ("primary_window", "secondary_window"):
            w = rl.get(slot)
            if not isinstance(w, dict):
                continue
            period = int(w.get("limit_window_seconds") or 0)
            label = codex_label(period)
            if prefix:
                label = prefix + " " + label
            used = w.get("used_percent")
            if used is None and rl.get("limit_reached"):
                used = 100
            resets = w.get("reset_at")
            if resets is None and w.get("reset_after_seconds") is not None:
                resets = time.time() + float(w["reset_after_seconds"])
            wins.append(window((prefix or "main") + ":" + slot, label, used, float(resets) if resets else None))
    add("", body.get("rate_limit"))
    add("review", body.get("code_review_rate_limit"))
    for extra in body.get("additional_rate_limits") or []:
        # "GPT-5.3-Codex-Spark" -> "spark": the last segment is the distinctive bit.
        name = (extra.get("limit_name") or "extra").split("-")[-1].lower()
        add(name[:8], extra.get("rate_limit"))
    return {"windows": wins, "plan": body.get("plan_type")}


def xai_cents(v):
    """Billing amounts arrive as {"val": n} or a bare number."""
    if isinstance(v, dict):
        v = v.get("val")
    try:
        return float(v) if v is not None else None
    except (TypeError, ValueError):
        return None


def xai_quota(weekly, monthly):
    """grok billing: weekly credits (percent + per-product) and a monthly spend
    cap in cents. Accounts without a metered cap report every value as 0 and
    get no windows."""
    wins = []
    w = (weekly or {}).get("config") or {}
    period_end = parse_iso(((w.get("currentPeriod") or {}).get("end")) or w.get("billingPeriodEnd"))
    if w.get("creditUsagePercent") is not None:
        wins.append(window("xai:weekly", "7d credits", w.get("creditUsagePercent"), period_end))
    for prod in w.get("productUsage") or []:
        if not isinstance(prod, dict):
            continue
        pct = prod.get("usagePercent", prod.get("usedPercent", prod.get("percent")))
        name = str(prod.get("name") or prod.get("product") or "product").lower()
        if pct is not None:
            wins.append(window("xai:product:" + name, "7d " + name[:7], pct, period_end))
    m = (monthly or {}).get("config") or {}
    limit, used = xai_cents(m.get("monthlyLimit")), xai_cents(m.get("used"))
    if limit and used is not None:
        wins.append(window("xai:monthly", "30d", 100.0 * min(used, limit) / limit, parse_iso(m.get("billingPeriodEnd"))))
    cap, on_used = xai_cents(m.get("onDemandCap")), xai_cents(m.get("onDemandUsed"))
    if cap and on_used is not None:
        wins.append(window("xai:ondemand", "on-demand", 100.0 * on_used / cap, parse_iso(m.get("billingPeriodEnd"))))
    return {"windows": wins, "plan": None, "note": None if wins else "no metered cap"}


# provider -> (urls fetched through api-call, headers, parser taking one body per url)
PROVIDERS = {
    "claude": ([CLAUDE_USAGE_URL], CLAUDE_HEADERS, claude_quota),
    "codex": ([CODEX_USAGE_URL], CODEX_HEADERS, codex_quota),
    "xai": ([XAI_WEEKLY_URL, XAI_MONTHLY_URL], XAI_HEADERS, xai_quota),
}


def fetch_quota(client, acct, prev, quota_interval, force):
    """Return the quota record for one account, reusing `prev` when fresh."""
    now = time.time()
    prov = PROVIDERS.get(acct["provider"])
    if not prov:
        return {"fetched_at": None, "stale": False, "error": "unsupported provider", "windows": []}
    if prev and not force:
        parked = prev.get("retry_until") or 0
        if parked > now:
            p = dict(prev)
            p["stale"] = bool(p.get("windows"))
            return p
        if prev.get("fetched_at") and now - prev["fetched_at"] < quota_interval and not prev.get("error"):
            return prev
    urls, headers, parse = prov
    bodies = []
    for url in urls:
        try:
            status, body, retry = client.api_call(acct["auth_index"], url, headers)
        except Exception as e:  # network / proxy error
            rec = dict(prev or {})
            rec.update({"error": "proxy: %s" % e, "stale": bool(rec.get("windows"))})
            return rec
        if status < 200 or status >= 300:
            break
        bodies.append(body)
    if status == 429:
        rec = dict(prev or {})
        rec.update({"error": "rate limited", "retry_until": now + (retry or 3600),
                    "stale": bool(rec.get("windows"))})
        rec.setdefault("windows", [])
        return rec
    if status < 200 or status >= 300 or not isinstance(body, dict):
        msg = ""
        if isinstance(body, dict):
            err = body.get("error")
            msg = err.get("message") if isinstance(err, dict) else (err or body.get("message") or "")
        rec = dict(prev or {})
        rec.update({"error": ("HTTP %s %s" % (status, msg)).strip(), "stale": bool(rec.get("windows"))})
        rec.setdefault("windows", [])
        return rec
    parsed = parse(*bodies)
    parsed.update({"fetched_at": now, "stale": False, "error": None, "retry_until": 0})
    return parsed


# ----------------------------------------------------------------- main

def main():
    settings = {}
    force = "--force" in sys.argv
    do_print = "--print" in sys.argv
    for a in sys.argv[1:]:
        if a.startswith("{"):
            settings = json.loads(a)
    base_url = settings.get("baseUrl") or "http://127.0.0.1:8317"
    key_file = os.path.expanduser(settings.get("keyFile") or "~/.config/omaquota/management-key")
    quota_interval = int(settings.get("quotaIntervalSec") or 900)
    host = settings.get("hostLabel") or base_url

    prev = load_json(SNAPSHOT, {})
    snap = {"generated_at": now_iso(), "generated_ts": time.time(), "host": host, "ok": False,
            "error": None, "stats": prev.get("stats") or {}, "accounts": prev.get("accounts") or []}
    try:
        with open(key_file) as f:
            key = f.read().strip()
    except OSError:
        snap["error"] = "no management key at %s - run omaquota-setup" % key_file
        save_json(SNAPSHOT, snap)
        return 1
    client = Client(base_url, key)

    try:
        files = (client.get("/v0/management/auth-files") or {}).get("files") or []
    except Exception as e:
        snap["error"] = "proxy unreachable: %s" % e
        for a in snap["accounts"]:
            a["stale"] = True
        save_json(SNAPSHOT, snap)
        if do_print:
            print(json.dumps(snap, indent=1))
        return 1

    usage = load_json(USAGE_FILE, {})
    usage_error = None
    try:
        drain_queue(client, usage)
        backfill_from_tracker(client, usage)
        save_json(USAGE_FILE, usage)
    except Exception as e:
        usage_error = "usage queue: %s" % e
    table = load_prices()
    stats = {rng: stats_for(usage, table, rng) for rng in RANGES}
    if usage_error:
        for st in stats.values():
            st["error"] = usage_error
    snap["stats"] = stats

    prev_q = {a["id"]: a.get("quota") for a in (prev.get("accounts") or []) if a.get("id")}
    accounts = []
    for f in files:
        accounts.append({
            "id": f.get("id") or f.get("name"),
            "auth_index": f.get("auth_index"),
            "provider": f.get("provider") or f.get("type") or "?",
            "email": f.get("email") or f.get("account") or f.get("label") or f.get("name"),
            "status": f.get("status") or "",
            "disabled": bool(f.get("disabled")),
            "unavailable": bool(f.get("unavailable")),
            "success": int(f.get("success") or 0),
            "failed": int(f.get("failed") or 0),
        })

    def work(acct):
        if acct["disabled"] or not acct["auth_index"]:
            return {"fetched_at": None, "stale": False, "error": "disabled" if acct["disabled"] else "no auth index", "windows": []}
        return fetch_quota(client, acct, prev_q.get(acct["id"]), quota_interval, force)

    with ThreadPoolExecutor(max_workers=6) as pool:
        for acct, q in zip(accounts, pool.map(work, accounts)):
            acct["quota"] = q

    order = {"claude": 0, "codex": 1, "xai": 2}
    accounts.sort(key=lambda a: (order.get(a["provider"], 9), a["email"].lower()))
    snap["accounts"] = accounts
    snap["ok"] = True
    save_json(SNAPSHOT, snap)
    if do_print:
        print(json.dumps(snap, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
